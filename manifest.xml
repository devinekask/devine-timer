<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="ContentApp">
  <Id>64D5E4CB-8406-44E7-AA64-C24DF875CB53</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Simon Vanherweghe</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Slide Timer" />
  <Description DefaultValue="A simple countdown timer you place on a slide. Set the time while editing, click it to start while presenting." />
  <IconUrl DefaultValue="https://devinekask.github.io/devine-timer/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://devinekask.github.io/devine-timer/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://devinekask.github.io/devine-timer/" />
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://devinekask.github.io/devine-timer/index.html" />
    <RequestedWidth>300</RequestedWidth>
    <RequestedHeight>150</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
